# Ignore Logseq content directories (synced via Syncthing)
journals/
pages/
assets/
.recycle/
.personal/
.work/

# Ignore Logseq cache and state tracking
**/pages_metadata.edn
**/graph-metadata.edn
**/bak/

# Explicitly whitelist configuration files
!personal/.logseq/config.edn
!personal/.logseq/custom.css
!work/.logseq/config.edn
!work/.logseq/custom.css

# Ignore Jujutsu operational history
.jj/

# Telegram Bot Secrets and State
.env
.direnv/
.offset
.offset.map

# Syncthing operational files
.stfolder/
.stversions/
.stignore
.stfolder.removed-*
